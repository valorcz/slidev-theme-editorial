{
	"name": "slidev-theme-editorial",
	"version": "0.0.9",
	"description": "A dark, editorial style theme for Slidev",
	"author": "Vašek Lorenc <vaclav.lorenc@gmail.com>",
	"license": "MIT",
	"homepage": "https://sli.dev",
	"repository": {
		"type": "git",
		"url": "https://github.com/valorcz/slidev-theme-editorial"
	},
	"bugs": "https://github.com/valorcz/slidev-theme-editorial/issues",
	"keywords": [
		"slidev-theme",
		"slidev"
	],
	"engines": {
		"node": ">=14.0.0",
		"slidev": ">=v0.47.0"
	},
	"slidev": {
		"defaults": {
			"fonts": {
				"sans": "Inter",
				"mono": "JetBrains Mono",
				"header": "DM Sans"
			},
			"style": "./styles/index.css"
		}
	},
	"dependencies": {
		"@slidev/types": "^0.47.5"
	},
	"scripts": {
		"dev": "slidev example.md --open",
		"build": "slidev build example.md",
		"export": "slidev export example.md",
		"screenshot": "slidev export example.md --format png"
	}
}
